# true = demo/mockdata, false = echte Azure/.NET API gebruiken
VITE_USE_MOCK=true

# Base URL van de backend API zodra VITE_USE_MOCK=false
VITE_API_BASE_URL=https://localhost:5001

# Timeout voor API-calls in milliseconden
VITE_API_TIMEOUT_MS=30000

# Optioneel: tenant/gemeente identifier meesturen als X-Tenant-ID header
VITE_API_TENANT_ID=
